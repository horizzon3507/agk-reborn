{
  "name": "agk-reborn",
  "version": "0.2.2",
  "description": "Multi-account manager for the Antigravity CLI (agy). Capture, switch, and monitor Google accounts from the terminal without the IDE.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agk": "./dist/cli.js",
    "agk-reborn": "./dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "dist/*.cjs",
    "dist/*.d.ts",
    "dist/*.d.cts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:bin": "bun build ./src/cli.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile bin/agk",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "biome check . && tsc --noEmit",
    "test": "pnpm run build && node --test \"tests/*.test.ts\"",
    "prepack": "pnpm run check && pnpm run test",
    "prepublishOnly": "pnpm run check && pnpm run test"
  },
  "keywords": [
    "antigravity",
    "agy",
    "cli",
    "google",
    "oauth",
    "accounts",
    "quota",
    "gemini"
  ],
  "author": "horizzon3507",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horizzon3507/agk-reborn.git"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "citty": "^0.2.2",
    "cli-table3": "^0.6.5",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.9.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
