{
  "name": "agk-reborn",
  "version": "0.1.0",
  "description": "Multi-account manager for the Antigravity CLI (agy). Capture, switch and monitor Google accounts — CLI-only, no IDE required.",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agk": "./dist/cli.js",
    "agk-reborn": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:bin": "tsup && bun build ./dist/cli.js --compile --outfile dist/agk",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "antigravity",
    "agy",
    "cli",
    "google",
    "oauth",
    "accounts",
    "quota",
    "gemini"
  ],
  "author": "horizzon3507",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/horizzon3507/agk-reborn"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "citty": "^0.1.6",
    "cli-table3": "^0.6.5",
    "gradient-string": "^3.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^22.9.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
